  "manufacturing_preference_hierarchy": [
    {
      "tier": 1,
      "label": "Primary In-House (Fastest, Lowest Cost)",
      "processes": [
        "power_tool_woodworking",
        "3d_printing_tough_pla_basic",
        "cnc_carving_onefinity"
      ],
      "guidance": "Default first to in-house woodworking, Tough PLA Basic 3D prints (with 0.4mm nozzle), or Onefinity CNC carving."
    },
    {
      "tier": 2,
      "label": "Specialty / Higher-Cost In-House",
      "processes": [
        "cnc_or_manual_corian_1_2in_with_mma",
        "3d_printing_tough_pla_pro",
        "cnc_acrylic_4in_or_1_8in",
        "secondary_filaments_petg_asa_tpu_pvb_cpe",
        "last_resort_prusament_pc"
      ],
      "guidance": "Use 1/2\" Corian + MMA glue when extreme dimensional rigidity or 100% vacuum-impermeable CNC jigs/pods are needed. Save Tough PLA Pro for justified high-impact/structural parts. Reserve Prusament PC as last-resort filament."
    },
    {
      "tier": 3,
      "label": "External Sheet Metal & Laser Cutting (SendCutSend - Deprioritized)",
      "processes": [
        "sheet_metal_sendcutsend"
      ],
      "guidance": "DEPRIORITIZE due to high unit/shipping cost and multi-day turnaround. Only choose when metal stiffness, heat resistance, thin-wall strength, or brass/copper/stainless hardware aesthetics are strictly required. Minimize secondary services (bending, countersinking, tapping, PEM) unless clearly cost-justified over flat cutting + in-house Portaband/Angle Grinder/countersink work."
    },
    {
      "tier": 4,
      "label": "External Machine Shop (Rare Last Resort)",
      "processes": [
        "external_cnc_machine_shop"
      ],
      "guidance": "Rare last resort for precision metal parts impossible in-house; produce formal 2D engineering drawings with hole callouts, datum structure, and GD&T."
    }
  ],
